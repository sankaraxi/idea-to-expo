# --- MySQL ------------------------------------------------------------------
# Import database/idea_to_expo.sql first (it creates the `idea_to_expo` database).
# URL-encode special characters in the password (@ -> %40, / -> %2F, : -> %3A).
# Add ?ssl=true for managed/cloud MySQL.
DATABASE_URL=mysql://root:your-password@127.0.0.1:3306/idea_to_expo
# Optional: max pooled connections (default 10).
# DATABASE_POOL_SIZE=10

# --- Google (server only) ---------------------------------------------------
# Service account; share the spreadsheets below with GOOGLE_CLIENT_EMAIL.
GOOGLE_CLIENT_EMAIL=
# Paste the PEM with literal \n line breaks, in double quotes.
GOOGLE_PRIVATE_KEY=
# Problem statement (Google Form response) spreadsheet + tab name.
# GOOGLE_FORM_RESPONSE_SHEET_ID is the long id between /d/ and /edit in the sheet URL (NOT the gid).
# EDITOR access required: scores and totals are written back into it.
GOOGLE_FORM_RESPONSE_SHEET_ID=
GOOGLE_FORM_RESPONSE_RANGE=Form Responses 1
# Optional separate reporting spreadsheet (Editor access) with Students /
# Evaluators / Evaluations / Results / Dashboard tabs. Leave empty to skip.
GOOGLE_SHEET_ID=
# Timezone used for timestamps written to the sheet.
SHEETS_TIMEZONE=Asia/Kolkata

# --- Shared secrets (>= 16 chars; generate with: openssl rand -hex 32) -------
# Apps Script webhook signature secret (same value in the Apps Script properties).
FORM_SYNC_SECRET=
# Bearer token for /api/sync/process (Vercel Cron sends it automatically).
CRON_SECRET=

# --- Seed script only (npm run db:seed) -------------------------------------
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=
SEED_EVALUATOR_PASSWORD=

# --- Tests only (npm run test:db) -------------------------------------------
# A MySQL server whose user may CREATE/DROP databases (each test gets a temp one).
# MYSQL_TEST_URL=mysql://root:your-password@127.0.0.1:3306
