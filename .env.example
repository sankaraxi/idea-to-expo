# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google (server only) ---------------------------------------------------
# Service account; share both spreadsheets with GOOGLE_CLIENT_EMAIL.
GOOGLE_CLIENT_EMAIL=
# Paste the PEM with literal \n line breaks, in double quotes.
GOOGLE_PRIVATE_KEY=
# Live reporting spreadsheet (Editor access for the service account).
GOOGLE_SHEET_ID=
# Google Form response spreadsheet (Viewer access is enough) + tab name.
GOOGLE_FORM_RESPONSE_SHEET_ID=
GOOGLE_FORM_RESPONSE_RANGE=Form Responses 1
# Timezone used for timestamps written to the sheet.
SHEETS_TIMEZONE=Asia/Kolkata

# --- Shared secrets (>= 16 chars; generate with: openssl rand -hex 32) -------
# Apps Script webhook signature secret (same value in the Apps Script properties).
FORM_SYNC_SECRET=
# Bearer token for /api/sync/process (Vercel Cron sends it automatically).
CRON_SECRET=

# --- Seed / bootstrap scripts only -------------------------------------------
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=
SEED_EVALUATOR_PASSWORD=
